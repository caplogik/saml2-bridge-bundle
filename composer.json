{
  "name": "caplogik/saml2-bridge-bundle",
  "description": "fork of https://packagist.org/packages/adactive-sas/saml2-bridge-bundle",
  "type": "symfony-bundle",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=7.1.3",
    "ext-openssl": "*",
    "simplesamlphp/saml2": "^4.0",
    "symfony/config": "^6.0",
    "symfony/dependency-injection": "^6.0",
    "symfony/form": "^6.0",
    "symfony/http-foundation": "^6.0",
    "symfony/security-bundle": "^6.0",
    "symfony/workflow": "^6.0",
    "twig/twig": "^1.34|^2.0|^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "symfony/phpunit-bridge": "^6.0",
    "liip/functional-test-bundle": "^4.12",
    "satooshi/php-coveralls": "^0.1.0"
  },
  "replace": {
    "adactive-sas/saml2-bridge-bundle": "*"
